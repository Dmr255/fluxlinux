<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- dmr255 fork ships like the F-Droid/GitHub flavor (not Play), so guests
         may mount /sdcard and /storage and the installer can pick up a manual
         rootfs from /sdcard/Download (#48, #29). Same grant as app/src/ivarna. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
</manifest>